InheritParentConfig: true
Checks:
  # TODO: Enable. The global test vectors have throwing initializers.
  - "-bugprone-throwing-static-initialization"
  # TODO: Enable. The state host overrides the public evmc::Host methods as private.
  - "-misc-override-with-different-visibility"
  # TODO(clang-tidy-24): Remove. Flags reference template parameters (llvm/llvm-project#224705).
  - "-readability-redundant-parentheses"
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: aNy_CasE
